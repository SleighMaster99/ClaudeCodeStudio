<Window x:Class="StatusBarEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StatusBarEditor.ViewModels"
        xmlns:m="clr-namespace:StatusBarEditor.Models"
        Title="Claude Code StatusBar 편집기"
        Width="1100" Height="900"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewQueryContinueDrag="Window_PreviewQueryContinueDrag"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Window.Resources>
        <!-- 미리보기 항목 칩 (드래그 가능) -->
        <DataTemplate x:Key="PreviewItemTemplate" DataType="{x:Type m:Item}">
            <Border Background="{Binding Background}"
                    BorderBrush="#888" BorderThickness="1"
                    CornerRadius="3"
                    Margin="3" Padding="8,6"
                    MinWidth="100"
                    Tag="{Binding}"
                    PreviewMouseLeftButtonDown="DragSource_MouseDown"
                    MouseMove="PreviewItem_MouseMove"
                    MouseRightButtonUp="PreviewItem_RightClick"
                    Cursor="Hand">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="{Binding Sample}" Foreground="#3C5A8C"
                               FontFamily="Consolas" FontSize="12" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Description}" Foreground="Gray"
                               FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 팔레트 항목 칩 (드래그 가능) -->
        <DataTemplate x:Key="PaletteItemTemplate" DataType="{x:Type m:ItemTypeInfo}">
            <Border Background="#E8F0FC"
                    BorderBrush="#888" BorderThickness="1"
                    CornerRadius="3"
                    Margin="3" Padding="8,6"
                    MinWidth="140"
                    Tag="{Binding}"
                    PreviewMouseLeftButtonDown="DragSource_MouseDown"
                    MouseMove="PaletteItem_MouseMove"
                    Cursor="Hand">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="{Binding Sample}" Foreground="#3C5A8C"
                               FontFamily="Consolas" FontSize="12" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Description}" Foreground="Gray"
                               FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 미리보기 -->
        <GroupBox Header="미리보기 (드래그 = 이동, 우클릭 = 삭제, 줄 사이로 드롭 = 새 줄)" Grid.Row="0" Margin="0,0,0,5">
            <Border Background="White" BorderBrush="#CCC" BorderThickness="1">
                <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Background="Transparent">
                    <ItemsControl x:Name="PreviewRows" ItemsSource="{Binding Layout.Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Row}">
                                <StackPanel>
                                    <!-- 줄 사이 드롭 존 -->
                                    <Border Height="12" Background="Transparent"
                                            AllowDrop="True"
                                            DragOver="InterRowZone_DragOver"
                                            DragLeave="InterRowZone_DragLeave"
                                            Drop="InterRowZone_Drop"
                                            Tag="{Binding}"/>
                                    <!-- 줄 본체 -->
                                    <Border BorderBrush="#DDD" BorderThickness="1" Background="#FCFCFC"
                                            Padding="4" Margin="0,0,0,0"
                                            AllowDrop="True"
                                            DragOver="Row_DragOver"
                                            DragLeave="Row_DragLeave"
                                            Drop="Row_Drop"
                                            Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="≡" Foreground="Gray" Margin="4,8,4,4"
                                                       FontSize="14" Cursor="SizeAll"
                                                       PreviewMouseLeftButtonDown="DragSource_MouseDown"
                                                       MouseMove="RowHandle_MouseMove"
                                                       Tag="{Binding}"/>
                                            <Button Content="×" Width="22" Height="22"
                                                    Margin="2,6,6,4" Padding="0"
                                                    Tag="{Binding}" Click="DeleteRow_Click"
                                                    ToolTip="줄 삭제"/>
                                            <ItemsControl ItemsSource="{Binding Items}"
                                                          ItemTemplate="{StaticResource PreviewItemTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 마지막 줄 아래 trailing 드롭 존 -->
                    <Border x:Name="TrailingZone" Height="24" Background="Transparent"
                            AllowDrop="True"
                            DragOver="TrailingZone_DragOver"
                            DragLeave="TrailingZone_DragLeave"
                            Drop="TrailingZone_Drop"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </GroupBox>

        <!-- 팔레트 -->
        <GroupBox Header="항목 (위로 드래그 = 추가, 미리보기 항목을 여기로 드래그 = 삭제)" Grid.Row="1" Margin="0,5,0,0"
                  AllowDrop="True"
                  DragOver="PaletteArea_DragOver"
                  Drop="PaletteArea_Drop">
            <DockPanel Background="Transparent"
                       AllowDrop="True"
                       DragOver="PaletteArea_DragOver"
                       Drop="PaletteArea_Drop">
                <!-- 구분자/포맷 (항상 보임) -->
                <GroupBox Header="{Binding Separators.Name}" DockPanel.Dock="Bottom" Height="180" Margin="0,5,0,0"
                          AllowDrop="True"
                          DragOver="PaletteArea_DragOver"
                          Drop="PaletteArea_Drop">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  AllowDrop="True"
                                  DragOver="PaletteArea_DragOver"
                                  Drop="PaletteArea_Drop">
                        <ItemsControl ItemsSource="{Binding Separators.Items}"
                                      ItemTemplate="{StaticResource PaletteItemTemplate}"
                                      AllowDrop="True"
                                      DragOver="PaletteArea_DragOver"
                                      Drop="PaletteArea_Drop">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>

                <!-- 카테고리별 탭 -->
                <TabControl ItemsSource="{Binding PaletteTabs}"
                            AllowDrop="True"
                            DragOver="PaletteArea_DragOver"
                            Drop="PaletteArea_Drop">
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PaletteGroup}">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:PaletteGroup}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White"
                                          AllowDrop="True"
                                          DragOver="PaletteArea_DragOver"
                                          Drop="PaletteArea_Drop">
                                <ItemsControl ItemsSource="{Binding Items}"
                                              ItemTemplate="{StaticResource PaletteItemTemplate}"
                                              AllowDrop="True"
                                              DragOver="PaletteArea_DragOver"
                                              Drop="PaletteArea_Drop">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </DockPanel>
        </GroupBox>

        <!-- 버튼 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="+ 새 줄" Grid.Column="0" Width="90" Height="32" Click="AddRow_Click"/>
            <Button x:Name="BtnReload" Content="되돌리기" Grid.Column="2" Width="110" Height="32"
                    Margin="0,0,8,0" Click="Reload_Click"
                    IsEnabled="{Binding IsDirty}"/>
            <Button Content="저장 &amp; 적용" Grid.Column="3" Width="130" Height="32"
                    Background="#468C50" Foreground="White" BorderThickness="0"
                    Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
